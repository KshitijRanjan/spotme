# AWS Rekognition credentials
# Create an IAM user with AmazonRekognitionFullAccess and generate access keys
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-central-1

# Google Drive API
# Path to the service account JSON file downloaded from Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# The Google Drive folder ID containing the wedding photos
# Found in the URL: drive.google.com/drive/folders/<GDRIVE_FOLDER_ID>
GDRIVE_FOLDER_ID=your_google_drive_folder_id

# The AWS Rekognition collection name (created automatically by index_photos.py)
REKOGNITION_COLLECTION_ID=wedding_faces

# Supabase PostgreSQL connection string
# Found in: Supabase dashboard → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# URL of the deployed Streamlit frontend — used by Render to restrict CORS
# Format: https://<your-app-name>.streamlit.app
# Leave blank during local development
ALLOWED_ORIGINS=https://yourapp.streamlit.app

# URL of the deployed FastAPI backend on Render — used by Streamlit Cloud
# Format: https://<your-service-name>.onrender.com
# Defaults to http://127.0.0.1:8000 during local development
BACKEND_URL=https://your-service-name.onrender.com
